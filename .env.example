# Target deployment. Valid values: staging, sit, uat, production.
TEST_ENVIRONMENT=staging

# Compose defaults to Selenium Grid. Valid values: grid, browserstack.
EXECUTION_PROVIDER=grid
HEADLESS_MODE=true
TEST_SUITE=**/CucumberTestSuite.java
CUCUMBER_FILTER_TAGS=@CartPrice

# SauceDemo's public URL is the only repository default.
SAUCEDEMO_STAGING_URL=https://www.saucedemo.com
SAUCEDEMO_SIT_URL=
SAUCEDEMO_UAT_URL=
SAUCEDEMO_PRODUCTION_URL=
# Optional overrides for a deployment-specific test account. Supply through a secret store in CI.
SAUCEDEMO_TEST_USERNAME=
SAUCEDEMO_TEST_PASSWORD=

# Set credentials through a secure secret store; do not commit real values here.
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
